# R session / build artifacts
.Rhistory
.RData
.Rproj.user/
*.Rout
src/*.o
src/*.so

# Generated run outputs (reproducible from code + config; not tracked).
# Curated examples are kept separately under docs/example_outputs/.
outputs/

# Generated / downloaded station data (reproducible; synthetic demo or GHCN cache)
data/external/
data/synthetic/
data/raw/
data/processed/
data/ghcn_prcp_cache/
data/cluster_cache/

# Per-facility configs generated from the manifest by run_batch.R
config/facilities/

# NOTE: golden/ IS tracked on purpose — it is the frozen known-answer dataset
# and reference used by run_golden.R and the regression test.

# testthat failure artifact (regenerated; not tracked)
tests/testthat/testthat-problems.rds

# NID tranche temp manifest (regenerated each run)
data/nid_progress/_tranche_current.csv
data/nid_progress/*.log

# QC data cache (read-only extracts of the fleet branch, keyed by commit)
qc/_cache/
__pycache__/

# B1 Atlas 14 sampler: raw PFDS responses, ledgers, fleet/grid extracts
# (analysis/b1_atlas14_sampler.py). Committed summaries live in summary/.
data/atlas14/*
!data/atlas14/summary/
data/atlas14/summary/full_sample_frame.csv
